{
  "schemaVersion": 1,
  "id": "wover-pottable",
  "version": "${version}",
  "name": "WorldWeaver - Pottable API",
  "description": "Provides a datapack-driven registry for pottable plants and soils (e.g. for flower pots).",
  "authors": [
    "Quiqueck"
  ],
  "contact": {
    "homepage": "https://github.com/Reijin2312/WorldWeaver-New-Dawn",
    "sources": "https://github.com/Reijin2312/WorldWeaver-New-Dawn",
    "issues": "https://github.com/Reijin2312/WorldWeaver-New-Dawn/issues"
  },
  "license": "MIT",
  "icon": "assets/wover-pottable/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.betterx.wover.entrypoint.LibWoverPottable"
    ],
    "wover.datapack.registry": [
      "org.betterx.wover.entrypoint.PottableDatapackRegistryEntrypoint"
    ]
  },
  "accessWidener": "wover-pottable.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.3",
    "minecraft": ["1.21", "1.21.1"],
    "java": ">=21",
    "fabric-api": ">=0.100.0"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "parent": "wover"
    }
  }
